# The offline example runs without credentials.
# The live lane evaluates your HTTP application and observes its state through
# a separate endpoint. Both endpoints must return the contracts in docs/ADAPTING.md.
EVAL_SUT_RUN_URL=http://127.0.0.1:8080/eval/run
EVAL_EVIDENCE_URL=http://127.0.0.1:8081/eval/evidence

# OpenAI is used only as the optional calibrated judge, never by pull-request CI.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-5-mini
